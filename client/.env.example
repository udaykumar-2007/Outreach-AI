# Supabase project details (obtain from Supabase Dashboard > Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Sandbox Mode: set to true to run in local developer mode bypassing database configuration
VITE_USE_MOCK_AUTH=true
