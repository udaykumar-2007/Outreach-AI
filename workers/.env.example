# Supabase credentials (Service role required to update tables bypassing client filters)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-share

# Redis connection details (must match server's Redis)
REDIS_URL=redis://localhost:6379

# Google Gemini API credentials (needs access to gemini-2.5-flash)
GEMINI_API_KEY=your-google-gemini-api-key

# Simulation Mode: if true, crawls mock local endpoints instead of querying real networks
SIMULATE_AUTOMATION=true
