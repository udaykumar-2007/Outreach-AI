# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase API Details
# Found under Project Settings > API in your Supabase Dashboard
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-share

# Redis connection details (for BullMQ queues)
REDIS_URL=redis://localhost:6379

# Simulation Mode: if true, Playwright uses mock HTML pages rather than hitting real LinkedIn/Twitter/Upwork servers
SIMULATE_AUTOMATION=true
